# Copy to PROJECT/.operations.env; chmod 600. Replace destinations when ready.
# BACKUP_REMOTE=user@backup-host:/srv/rag-backups/
BACKUP_REMOTE=
# Default local copy location: PROJECT/backups; put on a separate disk if possible.
# BACKUP_DIR=/mnt/backup/rag
OPERATIONS_ALERT_WEBHOOK=
# Change to the public HTTPS domain to monitor the external nginx/TLS path too.
OPERATIONS_READY_URL=http://127.0.0.1:3001/api/ready
OPERATIONS_MIN_FREE_RATIO=0.15
OPERATIONS_BACKUP_MAX_AGE_SECONDS=172800
