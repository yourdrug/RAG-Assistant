# Скопируй в .env:  cp .env.example .env
# Читается docker-compose.yml автоматически (DOMAIN, DOCKER_MTU, QDRANT_API_KEY, POSTGRES_PASSWORD).
# Настройки приложения — в server/.env (см. server/.env.example).

# --- PostgreSQL (обязательно для postgres image) ---
POSTGRES_PASSWORD=ragpassword

# --- Qdrant ---
# openssl rand -hex 24
QDRANT_API_KEY=qdrant_api_key

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- HTTPS (Caddy) ---
# Раскомментируй для домена (task up:public):
DOMAIN=rag.example.com
ACME_EMAIL=postmaster@example.com

# --- Docker-сеть ---
# Снижай до 1400 если на хосте VPN (иначе рвутся TLS-пакеты)
DOCKER_MTU=1500
