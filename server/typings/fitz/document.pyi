from collections.abc import Iterator, Sequence
from os import PathLike
from types import TracebackType
from typing import Any, Literal, Self, overload

class Colorspace:
    def __init__(self, value: int) -> None: ...

class Point:
    def __add__(self, other: Point) -> Point: ...
    def __truediv__(self, value: float) -> Point: ...

class Rect:
    x0: float
    y0: float
    x1: float
    y1: float
    width: float
    height: float
    top_left: Point
    bottom_right: Point
    @overload
    def __init__(self, coordinates: Sequence[float]) -> None: ...
    @overload
    def __init__(self, x0: float, y0: float, x1: float, y1: float) -> None: ...
    def __iter__(self) -> Iterator[float]: ...
    def __contains__(self, point: Point) -> bool: ...
    def __or__(self, other: Rect) -> Rect: ...

class Matrix:
    def __init__(self, horizontal: float, vertical: float) -> None: ...

class Font:
    buffer: bytes
    def __init__(self, name: str) -> None: ...

class Table:
    bbox: tuple[float, float, float, float]
    def extract(self) -> list[list[str | None]]: ...

class TableFinder:
    tables: list[Table]

class Pixmap:
    width: int
    height: int
    samples: bytes
    def tobytes(self, output: str = "png") -> bytes: ...

class Page:
    rect: Rect
    @overload
    def get_text(self, option: Literal["text"] = "text", *, flags: int = ...) -> str: ...
    @overload
    def get_text(
        self, option: Literal["blocks"], *, flags: int = ...
    ) -> list[tuple[float, float, float, float, str, int, int]]: ...
    @overload
    def get_text(self, option: Literal["dict"], *, flags: int = ...) -> dict[str, Any]: ...
    def find_tables(self) -> TableFinder: ...
    def get_pixmap(
        self, *, dpi: int = 72, matrix: Matrix | None = None, colorspace: object = ..., alpha: bool = False
    ) -> Pixmap: ...
    def insert_text(
        self, point: tuple[float, float], text: str, *, fontsize: float = 11, fontname: str = "helv"
    ) -> int: ...
    def get_images(self, *, full: bool = False) -> list[tuple[object, ...]]: ...
    def get_image_info(self) -> list[dict[str, Any]]: ...
    def insert_font(self, *, fontname: str, fontbuffer: bytes) -> int: ...
    def insert_textbox(
        self, rect: Rect, text: str, *, fontsize: float = 11, fontname: str = "helv"
    ) -> float: ...
    def insert_image(self, rect: Rect, *, stream: bytes) -> int: ...
    def draw_line(self, start: tuple[float, float], end: tuple[float, float]) -> object: ...

class Document:
    metadata: dict[str, str]
    def __init__(self, filename: str | PathLike[str] | None = None) -> None: ...
    def __len__(self) -> int: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None
    ) -> None: ...
    def __getitem__(self, index: int) -> Page: ...
    def get_toc(self) -> list[list[Any]]: ...
    def set_toc(self, toc: list[list[Any]]) -> int: ...
    def set_metadata(self, metadata: dict[str, str]) -> None: ...
    def load_page(self, index: int) -> Page: ...
    def new_page(self, *, width: float = 595, height: float = 842) -> Page: ...
    def save(self, filename: str | PathLike[str], *, deflate: bool = False) -> None: ...
    def close(self) -> None: ...
