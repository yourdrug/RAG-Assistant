# Полный справочник конфигурации. task env копирует шаблоны без перезаписи.
# Секреты: server/.env.secrets (0600), см. .env.secrets.example.
# Необязательные overrides ниже закомментированы: defaults уже заданы в Settings.
# Динамические настройки в конце — справочник БД, env их НЕ переопределяет.
# Существующая установка: docs/operations/configuration.md (config migrate-env).

# Deployment: DeepInfra embeddings + reranking; ключ в .env.secrets.
# COMPOSE_PROFILES пустой отключает запуск локальных TEI при следующем up.
# ML_PROVIDER выбирает embeddings/reranking при запуске; БД его не переопределяет.
# Существующий TEI corpus требует миграции embeddings при смене провайдера.
STAGE=development
BUILD_TARGET=cpu
ML_PROVIDER=deepinfra
COMPOSE_PROFILES=
# APP_STAGE=prod
# SERVER_IMAGE=registry.example.com/rag-server:tag
# CLIENT_IMAGE=registry.example.com/rag-client:tag
# VERSION задаётся Taskfile из файла VERSION.
# DOCKER_MTU=1500
# TRUSTED_PROXY_CIDR=127.0.0.1

# Обязательные подключения и bootstrap.
DB_HOST=postgres
DB_PORT=5432
DB_USER=raguser
DB_NAME=ragdb
ALLOWED_ORIGINS=http://localhost:3001
FORWARDED_ALLOW_IPS=127.0.0.1
REDIS_HOST=redis
REDIS_USER=redis
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-documents
S3_REGION=us-east-1
ADMIN_EMAIL=admin@example.com

# Необязательные статические параметры (применяются при пересоздании процессов).
# Списки/кортежи задаются JSON; ALLOWED_ORIGINS и DB_SLAVE_* — через запятую.
# ML_INTERNAL_ALLOWED_ORIGINS — доверенные внутренние endpoints, не облачные API.
# TEI_EMBED_MODEL используется только при ML_PROVIDER=tei.
# DATA_DIR — локальные служебные файлы; документы хранятся в S3.
# EVIDENCE_PROFILE=belarus
# DB_SLAVE_HOSTS=
# DB_SLAVE_PORTS=
# DB_POOL_SIZE=40
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SEC=1800
# DB_STATEMENT_TIMEOUT_MS=600000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000
# QDRANT_TIMEOUT=10
# QDRANT_SEARCH_MAX_CONCURRENT=16
# QDRANT_WRITE_MAX_CONCURRENT=8
# RAG_RETRIEVAL_SCORE_THRESHOLD=0.0
# LLM_MAX_CONCURRENT=16
# LLM_GENERATION_MAX_CONCURRENT=12
# LLM_AUXILIARY_MAX_CONCURRENT=4
# LLM_REQUEST_TIMEOUT=120
# LLM_AUXILIARY_TIMEOUT=30
# EMBEDDING_MAX_CONCURRENT=16
# INGESTION_MAX_CONCURRENT=8
# RERANKER_MAX_CONCURRENT=8
# SEMAPHORE_ACQUIRE_TIMEOUT=30
# BENCHMARK_MAX_CONCURRENT=10
# BENCHMARK_JUDGE_MAX_CONCURRENT=3
# BENCHMARK_JUDGE_GROUPED_ENABLED=true
# BENCHMARK_JUDGE_INITIAL_TOKENS=2048
# BENCHMARK_JUDGE_RETRY_TOKENS=8192
# BENCHMARK_JUDGE_MODEL=
# TEI_EMBED_MODEL=BAAI/bge-m3
# EMBEDDING_REVISION=v1
# ML_INTERNAL_ALLOWED_ORIGINS=["http://tei-embed:8080", "http://tei-rerank:8080", "http://qdrant:6333", "http://localhost:6333"]
# OCR_VL_URL=http://ocr-vl:8080
# OCR_VL_TIMEOUT=180
# EMBED_DIM=1024
# CURATOR_SCOPE_MAX_IDS=1000
# REDIS_PORT=6379
# REDIS_DB=0
# WORKER_MAX_CONCURRENT=4
# OUTBOX_MAX_CONCURRENT=5
# REDIS_SOCKET_TIMEOUT=10
# REDIS_MAX_CONNECTIONS=50
# S3_MAX_CONCURRENT=10
# SUPPORTED_EXTENSIONS=[".pdf", ".docx", ".rtf", ".md", ".txt"]
# DATA_DIR=/code/project/data
# UPLOADS_PREFIX=uploads/
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440
# TIMEZONE=UTC
# RATE_LIMIT_REDIS_PREFIX=rag:ratelimit:v1:
# RATE_LIMIT_MAX_BUCKETS=10000
# LLM_BREAKER_FAIL_MAX=5
# LLM_BREAKER_TIMEOUT_DURATION=300

# Динамические параметры — ТОЛЬКО PostgreSQL / админка, НЕ env-переменные.
# Ниже key=default для новой БД; существующие значения БД сохраняются.
# Endpoints/collection и embedding identity меняются через corpus workflow.
# Доменные параметры имеют отдельный domain_key (указан рядом с ключом).

# [corpus]
# qdrant_url=http://qdrant:6333
# collection_name=company_docs

# [cost]
