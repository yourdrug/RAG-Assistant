# Скопируй в server/.env:  cp server/.env.example server/.env

STAGE=development
BUILD_TARGET=cpu

# ===========================================================================
# PostgreSQL
# ===========================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=raguser
DB_PASSWORD=ragpassword
DB_NAME=ragdb

# ===========================================================================
# Qdrant
# ===========================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant_api_key  # openssl rand -hex 24
COLLECTION_NAME=company_docs

# ===========================================================================
# Ollama (LLM)
# ===========================================================================
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:7b (Apache-2.5) — лёгкая и быстрая модель.
# Альтернатива: qwen2.5:14b (лучшее качество), mistral-nemo:12b (Apache-2.0).
LLM_MODEL=qwen2.5:7b

# ===========================================================================
# LLM Provider Selection (ollama | openrouter)
# ===========================================================================
# Переключатель провайдера LLM: "ollama" (локальный) или "openrouter" (облачный API)
# Можно менять динамически через API без перезапуска
LLM_PROVIDER=ollama

# ===========================================================================
# OpenRouter (облачный LLM API — альтернатива Ollama)
# ===========================================================================
# Требуется API-ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модели OpenRouter: https://openrouter.ai/models
# Примеры: qwen/qwen-2.5-7b-instruct, meta-llama/llama-3.1-8b-instruct, mistralai/mistral-7b-instruct
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# ===========================================================================
# TEI (Text Embeddings Inference)
# ===========================================================================
# Обязательные URL сервисов если ml_provider=tei. Пустые = ошибка при старте.
TEI_EMBED_URL=http://tei-embed:8080
TEI_RERANK_URL=http://tei-rerank:8080

# ===========================================================================
# ML Provider Selection (tei | deepinfra)
# ===========================================================================
# Переключатель провайдера embedding + reranking:
#   "tei"       — self-hosted Text Embeddings Inference (TEI_EMBED_URL/TEI_RERANK_URL обязательны)
#   "deepinfra" — managed API DeepInfra (DEEPINFRA_API_KEY обязателен)
ML_PROVIDER=tei

# ===========================================================================
# DeepInfra (managed embedding + reranking API — альтернатива self-hosted TEI)
# ===========================================================================
# Требуется API-ключ: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1
DEEPINFRA_EMBED_MODEL=BAAI/bge-m3
DEEPINFRA_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===========================================================================
# OCR (для сканов внутри PDF)
# ===========================================================================
OCR_ENABLED=true
# paddleocr (по умолчанию) — Apache-2.0, без ограничений.
# surya — точнее на сложной вёрстке, НО отдельная лицензия (см. README).
# auto — сначала PaddleOCR, если не дал текста — surya (если включён).
OCR_ENGINE=paddleocr
OCR_LANG_PADDLE=ru                      # ru | en | ...
OCR_DPI=300

# ===========================================================================
# Авторизация (JWT)
# ===========================================================================
JWT_SECRET_KEY=change-me-in-production  # openssl rand -hex 24
JWT_EXPIRE_MINUTES=1440                 # 24 часа

# ===========================================================================
# CORS
# ===========================================================================
ALLOWED_ORIGINS=*

# ===========================================================================
# Файловое хранилище
# ===========================================================================
FILE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ===========================================================================
# Приложение
# ===========================================================================
UPLOADS_PREFIX=uploads/

# Bootstrap-админ (создаётся при первом запуске, если задан)
# !! ВАЖНО: смени пароль перед деплоем в прод
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# ===========================================================================
# Timezone (IANA tz name)
# ===========================================================================
TIMEZONE=UTC

# ===========================================================================
# Redis (очередь задач, rate limiting, кэш API-ключей) — обязательный компонент
# ===========================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=redis
REDIS_PASSWORD=password
REDIS_DB=0
# Worker: макс. одновременных задач на воркер
WORKER_MAX_CONCURRENT=4
