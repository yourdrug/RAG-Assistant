# task env создаёт этот файл и server/.env.secrets без перезаписи.
# Секреты заполняются только в server/.env.secrets (mode 0600).
# LLM/OCR/RAG, endpoints, quotas и corpus: PostgreSQL / админка.
# Для существующей установки сначала выполните offline config migrate-env;
# не заменяйте рабочий env этим шаблоном. См. docs/operations/configuration.md.

# Docker deployment. COMPOSE_PROFILES выбирает сервисы, независимо от ML_PROVIDER в БД.
STAGE=development
BUILD_TARGET=cpu
COMPOSE_PROFILES=tei
# Production helper задаёт APP_STAGE=prod и поддерживает SERVER_IMAGE/CLIENT_IMAGE.

# Bootstrap PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=raguser
DB_NAME=ragdb

# CORS: перед production задайте адрес UI.
ALLOWED_ORIGINS=http://localhost:3001
FORWARDED_ALLOW_IPS=127.0.0.1

# Redis использует именованного пользователя в docker-compose.yml.
REDIS_HOST=redis
REDIS_USER=redis

# Статическое S3 подключение; ключи — в secret env.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# Bootstrap admin; пароль — в secret env.
ADMIN_EMAIL=admin@example.com

# Необязательные static overrides добавляйте только при необходимости.
# FILE_BACKEND=local требует доступного DATA_DIR; S3 не требует DATA_DIR.

# Preview resource limits (independent of document upload limits)
PREVIEW_MAX_SIZE_MB=50
PREVIEW_CACHE_TTL_SECONDS=1800
