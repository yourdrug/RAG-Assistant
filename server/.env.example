# Статическая конфигурация (bootstrap). Секреты — server/.env.secrets.
# Остальные статические параметры имеют defaults в server/app/config/sections/.
# Динамические (RAG, LLM, OCR, rate limit, ...) — только в БД через админку, не в env.

# Compose: без GPU — COMPOSE_PROFILES= и ocr_engine=paddleocr в админке; tei — локальные embeddings.
STAGE=development
BUILD_TARGET=cpu
COMPOSE_PROFILES=ocr-vl

DB_HOST=postgres
DB_PORT=5432
DB_USER=raguser
DB_NAME=ragdb

REDIS_HOST=redis
REDIS_USER=redis

S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-documents
S3_REGION=us-east-1

ALLOWED_ORIGINS=http://localhost:3001
FORWARDED_ALLOW_IPS=127.0.0.1
ADMIN_EMAIL=admin@example.com

# Частые overrides:
# Пакет предметной области; по умолчанию generic, юридическая инсталляция — belarus_law
# DOMAIN_PACK=belarus_law
# Внешние origins, куда админ может направить LLM_BASE_URL (ключ LLM_API_KEY уходит туда же)
# LLM_ALLOWED_ORIGINS=["https://openrouter.ai", "https://api.openai.com"]
# Внешние origins для EMBEDDING_BASE_URL/RERANK_BASE_URL (туда уходят EMBEDDING/RERANK_API_KEY)
# ML_ALLOWED_ORIGINS=["https://api.deepinfra.com", "https://api.jina.ai"]
# Модель эмбеддингов — часть идентичности корпуса; для локального TEI — model_id из его /info
# EMBEDDING_MODEL=BAAI/bge-m3
# ML_INTERNAL_ALLOWED_ORIGINS=["http://tei-embed:8080", "http://tei-rerank:8080", "http://qdrant:6333", "http://vllm:8000"]
# VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
# OCR_VL_FP16_FALLBACK=1       # GPU без bf16 (RTX 20xx)
# OCR_VL_MAX_PIXELS=501760
# WORKER_MEMORY_LIMIT=4G
