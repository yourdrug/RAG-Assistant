# Скопируй в server/.env:  cp server/.env.example server/.env
# Переменные Docker-сервисов (POSTGRES_*, MINIO_*, DOMAIN) — в корневом .env.

# ===========================================================================
# PostgreSQL
# ===========================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=raguser
DB_PASSWORD=ragpassword
DB_NAME=ragdb

# ===========================================================================
# Qdrant
# ===========================================================================
QDRANT_URL=http://qdrant:6333
# !! ВАЖНО: смени ключ перед деплоем в прод — openssl rand -hex 24
QDRANT_API_KEY=qdrant_api_key
COLLECTION_NAME=company_docs

# ===========================================================================
# Ollama (LLM)
# ===========================================================================
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:7b (Apache-2.5) — лёгкая и быстрая модель.
# Альтернатива: qwen2.5:14b (лучшее качество), mistral-nemo:12b (Apache-2.0).
LLM_MODEL=qwen2.5:7b

# ===========================================================================
# Эмбеддинги и реранкер (лицензионно безопасный набор, MIT)
# ===========================================================================
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cpu                              # cuda — если есть NVIDIA GPU (fallback для всех моделей)

# --- Устройства для моделей (отдельно от общего DEVICE) ---
# EMBED_DEVICE — устройство для embedding модели (пусто = использовать DEVICE)
# RERANK_DEVICE — устройство для reranker модели (пусто = использовать DEVICE)
# Пример: DEVICE=cpu, EMBED_DEVICE=cuda — embedding на GPU, всё остальное на CPU
# EMBED_DEVICE=
# RERANK_DEVICE=

# ===========================================================================
# OCR (для сканов внутри PDF)
# ===========================================================================
OCR_ENABLED=true
# paddleocr (по умолчанию) — Apache-2.0, без ограничений.
# surya — точнее на сложной вёрстке, НО отдельная лицензия (см. README).
# auto — сначала PaddleOCR, если не дал текста — surya (если включён).
OCR_ENGINE=paddleocr
OCR_LANG_PADDLE=ru                      # ru | en | ...
OCR_DPI=300

# ===========================================================================
# Авторизация (JWT)
# ===========================================================================
# ОБЯЗАТЕЛЬНО смени в проде — openssl rand -hex 32
# Приложение откажется запускаться в prod если останется дефолтное значение
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440                 # 24 часа

# ===========================================================================
# CORS
# ===========================================================================
ALLOWED_ORIGINS=*

# ===========================================================================
# Файловое хранилище
# ===========================================================================
FILE_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rag-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ===========================================================================
# Приложение
# ===========================================================================
DATA_DIR=/code/project/data
UPLOADS_PREFIX=uploads/

# Bootstrap-админ (создаётся при первом запуске, если задан)
# !! ВАЖНО: смени пароль перед деплоем в прод
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# ===========================================================================
# Timezone (IANA tz name)
# ===========================================================================
TIMEZONE=UTC

# ===========================================================================
# Redis (очередь задач, rate limiting, кэш API-ключей) — обязательный компонент
# ===========================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=redis
REDIS_PASSWORD=password
REDIS_DB=0
# Worker: макс. одновременных задач на воркер
WORKER_MAX_CONCURRENT=4
