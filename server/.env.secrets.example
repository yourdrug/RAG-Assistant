JWT_SECRET_KEY=
DB_PASSWORD=
QDRANT_API_KEY=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Временный пароль bootstrap-админа
ADMIN_PASSWORD=
