# ===========================================================================
# Шаблон секретов. Скопируй в server/.env.secrets и заполни реальными значениями:
#   cp server/.env.secrets.example server/.env.secrets
# Файл server/.env.secrets НЕ коммитится (в .gitignore).
# Генерация случайных значений:  openssl rand -hex 32
# ===========================================================================

# JWT подпись. Смена инвалидирует все выданные токены.
JWT_SECRET_KEY=

# PostgreSQL
DB_PASSWORD=

# Qdrant
QDRANT_API_KEY=

# Redis
REDIS_PASSWORD=

# MinIO / S3
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Bootstrap-админ (пароль — временный, сменить после первого входа)
ADMIN_PASSWORD=

# Облачные API-ключи (в dashboards провайдеров):
# https://deepinfra.com/dash/api_keys
# https://openrouter.ai/keys
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
