# Секреты (chmod 600, не коммитится). Генерация: openssl rand -hex 32
JWT_SECRET_KEY=
DB_PASSWORD=
QDRANT_API_KEY=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Временный пароль bootstrap-админа
ADMIN_PASSWORD=
# Ключи embedding/rerank endpoint (URL — в админке); пусто для локального TEI без auth
EMBEDDING_API_KEY=
RERANK_API_KEY=
# Ключ OpenAI-совместимого LLM endpoint (URL и модель — в админке); пусто для vLLM/Ollama без auth
LLM_API_KEY=
# Только вне Compose (Compose генерирует .deploy/metrics.env)
METRICS_SCRAPE_TOKEN=
# Секрет вебхука GitHub App каналов синхронизации; пусто — эндпоинт вебхука выключен
GITHUB_WEBHOOK_SECRET=
