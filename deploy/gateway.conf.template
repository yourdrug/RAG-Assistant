# Stable entry point; application and frontend replicas roll behind this proxy.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Real-IP;
real_ip_recursive off;

map $http_x_forwarded_proto $forwarded_scheme {
    default $scheme;
    https https;
    http http;
}

resolver 127.0.0.11 valid=2s ipv6=off;
upstream frontend {
    zone frontend 64k;
    server client:80 resolve;
}

server {
    listen 80;
    client_max_body_size 100m;
    location = /gateway-live {
        return 200;
    }
    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }
}
